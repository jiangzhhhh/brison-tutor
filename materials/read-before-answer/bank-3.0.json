rain","categoryTitle":"看清所问"},{"id":"T46","title":"只算自己的","domain":"math","skills":["限定条件","数量范围"],"passage":[{"id":"s1","text":"小禾有12张彩纸，用了5张，老师又给他3张，剩下的都放进自己的文件夹。"},{"id":"s2","text":"小安另有7张，用了2张，两人没有互相取用。"}],"question":"下课前，小禾自己的文件夹里一共有多少张彩纸？","targets":[{"label":"小安剩下的彩纸数","needed":false,"steps":[{"kind":"number","prompt":"填写张数。","answer":5,"explanation":"7-2=5是小安的。","calc":"7-2","id":"p1"}],"id":"t2"},{"label":"两人剩余彩纸合计","needed":false,"steps":[{"kind":"number","prompt":"填写张数。","answer":15,"explanation":"10+5=15，但题目只问小禾。","calc":"12-5+3+7-2","id":"p1"}],"id":"t3"},{"label":"小禾文件夹里的彩纸数","needed":true,"steps":[{"kind":"number","prompt":"第一步：自己的12张用去5张后，还剩多少张？","answer":7,"explanation":"12-5=7。","calc":"12-5","id":"p1"},{"kind":"number","prompt":"第二步：再加上老师给小禾的3张，共多少张？","answer":10,"explanation":"7+3=10；同桌的纸不算。","calc":"12-5+3","id":"p2"}],"id":"t1"}],"trap":true,"evidence":{"prompt":"选出直接帮助完成题目要求的句子。可多选，选好后再答题。","answers":[["s1"]],"allowed":["s1","s2"],"explanation":"直接依据需要选全；补充条件可以选，无关信息不选。"},"taskSpans":["小禾自己的文件夹","多少张彩纸"],"tokens":[],"referenceEdges":[],"mode":"train","blockId":"requirements","sourceMode":"train","categoryTitle":"看清所问"},{"id":"T01","title":"图书角的新安排","domain":"reading","skills":["信息筛选","多问完整"],"passage":[{"id":"s1","text":"原先安排小雨写图书标签，后来改由阿哲写。"},{"id":"s2","text":"修补好的书放在靠门的矮书架上。"},{"id":"s3","text":"桌上有3盒彩笔。"}],"question":"最后是谁负责写图书标签，修补好的书又放在哪里？","targets":[{"label":"桌上原有多少盒彩笔","needed":false,"steps":[{"kind":"number","prompt":"填写盒彩笔的数量。","answer":3,"explanation":"文中是三盒彩笔，但题目没有问。","id":"p1"}],"id":"t3"},{"label":"修补好的书最后放置的位置","needed":true,"steps":[{"kind":"single","prompt":"选出位置。","options":[{"id":"o0","text":"窗边桌上"},{"id":"o1","text":"原来的高书架"},{"id":"o2","text":"靠门的矮书架"}],"answer":"o2","explanation":"最后决定放在靠门的矮书架。","id":"p1"}],"id":"t2"},{"label":"最后负责写标签的人","needed":true,"steps":[{"kind":"single","prompt":"选出人物。","options":[{"id":"o0","text":"小雨"},{"id":"o1","text":"阿哲"},{"id":"o2","text":"小宁"}],"answer":"o1","explanation":"安排后来变更，实际写标签的是